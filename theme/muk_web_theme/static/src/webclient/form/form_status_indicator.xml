<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'o_form_button_save')]" position="replace">
            <button
                type="button"
                class="o_form_button_save btn btn-success me-1"
                data-hotkey="s"
                t-on-click.stop="save"
                data-tooltip="Save manually"
                aria-label="Save manually"
                t-ref="save">
                Save
            </button>
        </xpath>
        <xpath expr="//button[contains(@class, 'o_form_button_cancel')]" position="replace">
            <button
                type="button"
                class="o_form_button_cancel btn btn-danger"
                data-hotkey="j"
                t-on-click.stop="discard"
                data-tooltip="Discard all changes"
                aria-label="Discard all changes">
                Discard
            </button>
        </xpath>
    </t>

</templates>
